# Copy to keystore.properties (never commit it) to sign release builds locally.
# The same values can come from GAS24_KEYSTORE_FILE / GAS24_KEYSTORE_PASSWORD /
# GAS24_KEY_ALIAS / GAS24_KEY_PASSWORD environment variables (used by CI).
storeFile=/absolute/path/to/gas24-release.jks
storePassword=change-me
keyAlias=gas24
keyPassword=change-me
